#!/bin/bash
# User-side Apply. Never run as root. Never copies the plugin checkout into a
# root path. The privileged helper comes from package nomdelasociete-macpro.
set -euo pipefail
export PATH=/usr/bin:/usr/sbin
if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
  echo "user-apply must not run as root." >&2
  exit 1
fi

PLUGIN="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PKG=nomdelasociete-macpro
LIB=/usr/lib/nomdelasociete-macpro
HELPER="$LIB/apply"
SUDO=/usr/bin/sudo
ENV=/usr/bin/env
MARKER=nomdelasociete.macpro
HOME_REAL="$(/usr/bin/realpath "$HOME")"
case "$HOME_REAL" in
  /home/*) ;;
  *) echo "Refusing unexpected HOME=$HOME_REAL" >&2; exit 1 ;;
esac

owned_by_pkg() {
  [[ -x $1 ]] || return 1
  [[ $(pacman -Qqo "$1" 2>/dev/null || true) == "$PKG" ]]
}

echo "==> User files (no sudo)"
install -d -m 755 "$HOME/.config/uwsm" "$HOME/.config/hypr" \
  "$HOME/.config/systemd/user" "$HOME/.local/bin" \
  "$HOME/.local/state/omarchy" "$HOME/.config/omarchy" \
  "$HOME/.local/state/omarchy/indicators" \
  "$HOME/.local/state/omarchy/toggles"

python3 - <<'PY'
import json
from pathlib import Path
p = Path.home() / ".config/omarchy/shell.json"
d = json.loads(p.read_text()) if p.is_file() else {"version": 1}
d.setdefault("idle", {})
d["idle"]["screensaver"] = 150
d["idle"]["lock"] = 300
p.write_text(json.dumps(d, indent=2) + "\n")
PY
rm -f "$HOME/.local/state/omarchy/indicators/stay-awake"
rm -f "$HOME/.local/state/omarchy/toggles/screensaver-off"
touch "$HOME/.local/state/omarchy/toggles/suspend-off"

display_card=""
offload_card=""
for d in /sys/bus/pci/devices/*; do
  [[ -r $d/vendor && -r $d/class ]] || continue
  [[ $(cat "$d/vendor") == 0x1002 ]] || continue
  [[ $(cat "$d/class") == 0x03* ]] || continue
  card="$(basename "$(readlink -f "$d"/drm/card* 2>/dev/null | head -1)")"
  [[ $card == card* ]] || continue
  connected=0
  for conn in /sys/class/drm/${card}-*/status; do
    [[ -r $conn ]] || continue
    [[ $(cat "$conn") == connected ]] && connected=1
  done
  if [[ $connected -eq 1 && -z $display_card ]]; then
    display_card=$card
  else
    offload_card=${offload_card:-$card}
  fi
done
display_card="${display_card:-card2}"
offload_card="${offload_card:-card1}"
[[ $display_card == "$offload_card" ]] && offload_card=card1
echo "    AQ_DRM_DEVICES=/dev/dri/${display_card}:/dev/dri/${offload_card}"

uwsm="$HOME/.config/uwsm/env-hyprland"
touch "$uwsm"
grep -v 'AQ_DRM_DEVICES\|AQ_NO_ATOMIC' "$uwsm" >"${uwsm}.new" || true
cat >>"${uwsm}.new" <<EOF
# $MARKER
export AQ_DRM_DEVICES=/dev/dri/${display_card}:/dev/dri/${offload_card}
export AQ_NO_ATOMIC=1
EOF
mv -f "${uwsm}.new" "$uwsm"

cat >"$HOME/.config/hypr/${MARKER}.lua" <<'EOF'
-- Managed by nomdelasociete.macpro Apply. Do not put AQ_DRM_DEVICES here.
hl.env("LIBVA_DRIVER_NAME", "radeonsi")
hl.env("VDPAU_DRIVER", "radeonsi")
hl.env("AMD_VULKAN_ICD", "RADV")
hl.env("VK_ICD_FILENAMES", "/usr/share/vulkan/icd.d/radeon_icd.json")
hl.config({ cursor = { no_hardware_cursors = 1 } })
-- Sleep key would call logind suspend and wedge DP. Lock instead.
o.bind("XF86Sleep", "Lock (machine Sleep blocked)", "omarchy-system-lock", { locked = true })
o.bind("XF86Suspend", "Lock (machine Sleep blocked)", "omarchy-system-lock", { locked = true })
EOF
hypr="$HOME/.config/hypr/hyprland.lua"
if [[ -f "$hypr" ]] && ! grep -q "$MARKER.lua" "$hypr"; then
  printf '\n-- %s\ndofile(os.getenv("HOME") .. "/.config/hypr/%s.lua")\n' "$MARKER" "$MARKER" >>"$hypr"
fi

install -m 755 "$PLUGIN/bin/wifi-watch" "$HOME/.local/bin/omarchy-macpro-wifi-watch"
install -m 755 "$PLUGIN/bin/display-mode" "$HOME/.local/bin/omarchy-macpro-display-mode"
install -m 755 "$PLUGIN/bin/d700" "$HOME/.local/bin/d700"
cat >"$HOME/.config/systemd/user/${MARKER}-wifi-watch.service" <<EOF
[Unit]
Description=Mac Pro Broadcom Wi-Fi reconnect watchdog
After=graphical-session.target NetworkManager.service
PartOf=graphical-session.target
[Service]
Type=simple
ExecStart=%h/.local/bin/omarchy-macpro-wifi-watch
Restart=always
RestartSec=5
[Install]
WantedBy=graphical-session.target
EOF
/usr/bin/systemctl --user daemon-reload
/usr/bin/systemctl --user enable --now ${MARKER}-wifi-watch.service >/dev/null

cat >"$HOME/.local/state/omarchy/macpro-profile" <<EOF
applied=$(date -Iseconds)
product=$(tr -d '\0' </sys/class/dmi/id/product_name 2>/dev/null || true)
EOF

if ! owned_by_pkg "$HELPER"; then
  echo "==> Installing $PKG (pacman owns the root helper)"
  if command -v omarchy >/dev/null 2>&1; then
    if curl -sf --connect-timeout 8 "https://aur.archlinux.org/rpc/?v=5&type=info&arg=$PKG" \
         | grep -q '"resultcount":1'; then
      omarchy pkg aur add "$PKG" || true
    fi
  fi
  if ! owned_by_pkg "$HELPER"; then
    echo "    AUR package not listed; installing GitHub release v0.4.0"
    url="https://github.com/nomdelasociete/omarchy-mac-pro-2013/releases/download/v0.4.0/nomdelasociete-macpro-0.4.0-1-any.pkg.tar.zst"
    sha="80980c26a1dfbbf5e22e2f668cadd32190cfd5ee44847da293b3ea59a0a0c00d"
    tmp="$(mktemp --suffix=.pkg.tar.zst)"
    /usr/bin/curl -fsSL "$url" -o "$tmp"
    echo "$sha  $tmp" | /usr/bin/sha256sum -c --status
    $SUDO $ENV -i PATH=/usr/bin:/usr/sbin /usr/bin/pacman -U --noconfirm "$tmp"
    rm -f "$tmp"
  fi
fi
if ! owned_by_pkg "$HELPER"; then
  echo "Refusing: $HELPER is not owned by package $PKG." >&2
  echo "Install: sudo pacman -U https://github.com/nomdelasociete/omarchy-mac-pro-2013/releases/download/v0.4.0/nomdelasociete-macpro-0.4.0-1-any.pkg.tar.zst" >&2
  exit 1
fi

echo "==> Running pacman-owned helper (closed PATH)"
$SUDO $ENV -i PATH=/usr/bin:/usr/sbin SUDO_USER="$USER" LOGNAME="$USER" "$HELPER"

if command -v hyprctl >/dev/null 2>&1; then
  hyprctl reload >/dev/null 2>&1 || true
fi

echo
echo "Done. Screensaver 2.5 min, lock 5 min. Machine Sleep is blocked."
echo "No logout/reboot needed for this session. Do not use Sleep / Suspend / Hibernate."
read -r -p "Press Enter to close."
