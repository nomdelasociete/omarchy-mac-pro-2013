#!/bin/bash
set -euo pipefail
export PATH=/usr/bin:/usr/sbin
if [[ ${EUID:-$(id -u)} -eq 0 ]]; then
  echo "user-remove must not run as root." >&2
  exit 1
fi
MARKER=nomdelasociete.macpro
PKG=nomdelasociete-macpro
HELPER=/usr/lib/nomdelasociete-macpro/remove
SUDO=/usr/bin/sudo
ENV=/usr/bin/env
REMOVE_SHA256="e2ef79bb6fa64a0f0020df20f47dac9a2ee36926aa50da4491052ff7fd928158"

/usr/bin/systemctl --user disable --now ${MARKER}-wifi-watch.service >/dev/null 2>&1 || true
rm -f "$HOME/.config/systemd/user/${MARKER}-wifi-watch.service"
rm -f "$HOME/.config/hypr/${MARKER}.lua"
rm -f "$HOME/.local/state/omarchy/macpro-profile"
uwsm="$HOME/.config/uwsm/env-hyprland"
if [[ -f $uwsm ]]; then
  tmp="$(mktemp)"
  grep -v 'AQ_DRM_DEVICES\|AQ_NO_ATOMIC\|nomdelasociete.macpro' "$uwsm" >"$tmp" || true
  mv -f "$tmp" "$uwsm"
fi
if [[ -f $HOME/.config/hypr/hyprland.lua ]]; then
  tmp="$(mktemp)"
  grep -v "$MARKER" "$HOME/.config/hypr/hyprland.lua" >"$tmp" || true
  mv -f "$tmp" "$HOME/.config/hypr/hyprland.lua"
fi

got=""
if [[ -x $HELPER ]]; then
  got="$(/usr/bin/sha256sum "$HELPER" | awk '{print $1}')"
fi
if [[ -x $HELPER && $(pacman -Qqo "$HELPER" 2>/dev/null || true) == "$PKG" && $got == "$REMOVE_SHA256" ]]; then
  $SUDO $ENV -i PATH=/usr/bin:/usr/sbin SUDO_USER="$USER" "$HELPER"
else
  echo "Package $PKG helper missing or digest mismatch; skipped system remove."
fi
echo
read -r -p "Press Enter to close."
