#!/usr/bin/env bash
# Undo Apply. Does not uninstall the plugin or kill Hyprland.
set -euo pipefail
MARKER="nomdelasociete.macpro"

if [[ ${EUID:-$(id -u)} -ne 0 ]]; then
  exec sudo --preserve-env=HOME,SUDO_USER "$0" "$@"
fi

TARGET_USER="${SUDO_USER:-}"
TARGET_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"

rm -f /etc/udev/rules.d/99-${MARKER}.rules
udevadm control --reload-rules || true
rm -f /usr/lib/systemd/system-sleep/${MARKER}-dp-retrain
rm -f /etc/systemd/logind.conf.d/00-${MARKER}-sleep.conf
rm -f /etc/sddm.conf.d/11-${MARKER}-keyboard.conf
# Keep /etc/sddm/hyprland.lua if it is ours
if grep -q "$MARKER" /etc/sddm/hyprland.lua 2>/dev/null; then
  rm -f /etc/sddm/hyprland.lua
fi
systemctl kill -s HUP systemd-logind.service 2>/dev/null || true

if [[ -n "$TARGET_USER" ]]; then
  runuser -u "$TARGET_USER" -- systemctl --user disable --now ${MARKER}-wifi-watch.service >/dev/null 2>&1 || true
  rm -f "$TARGET_HOME/.config/systemd/user/${MARKER}-wifi-watch.service"
  rm -f "$TARGET_HOME/.config/hypr/${MARKER}.lua"
  rm -f "$TARGET_HOME/.local/state/omarchy/macpro-profile"
  if [[ -f $TARGET_HOME/.config/hypr/hyprland.lua ]]; then
    tmp="$(mktemp)"
    grep -v "$MARKER" "$TARGET_HOME/.config/hypr/hyprland.lua" >"$tmp" || true
    mv "$tmp" "$TARGET_HOME/.config/hypr/hyprland.lua"
    chown "$TARGET_USER:$TARGET_USER" "$TARGET_HOME/.config/hypr/hyprland.lua"
  fi
  # Leave uwsm AQ_DRM_DEVICES as card2:card1 if udev names will vanish
  if [[ -f $TARGET_HOME/.config/uwsm/env-hyprland ]]; then
    sed -i "s#/dev/dri/d700-display:/dev/dri/d700-offload#/dev/dri/card2:/dev/dri/card1#" \
      "$TARGET_HOME/.config/uwsm/env-hyprland" || true
  fi
fi

echo "Profile removed. Suspend is still masked until you unmask it yourself."
echo "Log out once if DRM device names changed."
