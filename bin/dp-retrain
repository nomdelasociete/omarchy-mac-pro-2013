#!/usr/bin/env bash
# systemd sleep hook: $1=pre|post  $2=suspend|hibernate|hybrid-sleep
# Retrain DP after wake. Never restart Hyprland/SDDM.
set -u
[[ ${1:-} == post ]] || exit 0

sleep 2

user=""
uid=""
while read -r sess; do
  u="$(loginctl show-session "$sess" -p Name --value 2>/dev/null || true)"
  t="$(loginctl show-session "$sess" -p Type --value 2>/dev/null || true)"
  [[ "$t" == wayland || "$t" == x11 ]] || continue
  user="$u"
  uid="$(id -u "$user" 2>/dev/null || true)"
  break
done < <(loginctl list-sessions --no-legend | awk '{print $1}')

[[ -n "$user" && -n "$uid" ]] || exit 0
export XDG_RUNTIME_DIR="/run/user/$uid"
export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$uid/bus"
wd=""
for cand in wayland-1 wayland-0; do
  [[ -S "$XDG_RUNTIME_DIR/$cand" ]] && { wd="$cand"; break; }
done
[[ -n "$wd" ]] || exit 0
export WAYLAND_DISPLAY="$wd"

hypr() { runuser -u "$user" -- env XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" WAYLAND_DISPLAY="$WAYLAND_DISPLAY" hyprctl "$@"; }

# Wait for a connected connector on the display GPU.
ok=0
for _ in $(seq 1 15); do
  if hypr monitors -j 2>/dev/null | grep -q '"id"'; then
    ok=1
    break
  fi
  sleep 1
done
[[ $ok -eq 1 ]] || exit 0

python3 - <<'PY' || true
import json, os, subprocess, time

def hypr(*args):
    env = os.environ.copy()
    return subprocess.run(["hyprctl", *args], env=env, capture_output=True, text=True)

raw = hypr("monitors", "all", "-j").stdout
try:
    mons = json.loads(raw)
except json.JSONDecodeError:
    raise SystemExit(0)
if not mons:
    raise SystemExit(0)
m = mons[0]
name = m.get("name") or ""
if not name:
    raise SystemExit(0)

# Always DPMS on after sleep.
hypr("dispatch", "hl.dsp.dpms({ action = \"enable\" })")

w, h = int(m.get("width") or 0), int(m.get("height") or 0)
if w >= 3000 and h >= 1000:
    raise SystemExit(0)

def parse(mode):
    mode = mode.replace("Hz", "")
    a, hz = mode.split("@")
    x, y = a.split("x")
    return int(x), int(y), float(hz)

modes = []
for raw_mode in m.get("availableModes") or []:
    try:
        modes.append(parse(raw_mode))
    except Exception:
        pass
if not modes:
    raise SystemExit(0)

train = next((x for x in modes if x[0] == 1920 and x[1] == 1080 and x[2] >= 59), None)
native = max(modes, key=lambda t: (t[0] * t[1], t[2]))
lua = "hl.monitor({ output = '%s', mode = '%dx%d@%g', position = '0x0', scale = 1 })"
if train:
    hypr("eval", lua % (name, train[0], train[1], train[2]))
    time.sleep(2)
hypr("eval", lua % (name, native[0], native[1], native[2]))
PY
exit 0
